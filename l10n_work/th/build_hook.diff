+def _merge_th_fields(section, details, *, override=False):
+    """Thai-only: merge authored detail fields into the built section.
+
+    Locale-guarded caller; no other locale is touched.  Existing Thai text
+    authored in the catalog (e.g. VT_NGU_MON_RATLON step prose) is preserved
+    unless ``override`` is set, so no good Thai content is replaced.
+    """
+    for key, fields in details.items():
+        entry = section.setdefault(key, {})
+        for field, value in fields.items():
+            if isinstance(value, dict) and isinstance(entry.get(field), dict):
+                merged = entry[field]
+                for sub_key, sub_value in value.items():
+                    slot = merged.setdefault(sub_key, {})
+                    if isinstance(sub_value, dict):
+                        for inner_key, inner_value in sub_value.items():
+                            if override or not slot.get(inner_key):
+                                slot[inner_key] = inner_value
+                    elif override or not slot:
+                        merged[sub_key] = sub_value
+            elif override or not entry.get(field):
+                entry[field] = value
+
+
