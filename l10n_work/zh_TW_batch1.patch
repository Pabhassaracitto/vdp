+# ---------------------------------------------------------------------------
+# 7. Wiring helper — for the integration agent.
+#
+#    Call ``apply(catalog)`` on the zh_TW catalog dict **after** the existing
+#    builder has produced it and **before** it is serialised. It only fills
+#    keys that are missing (or empty) and never overwrites a value that is
+#    already there, so shipped zh_TW step text and names survive. The vithi
+#    step numbers listed in ``VITHIS_ZH_TW[...]["STEPS"]`` are the ones that
+#    are currently absent from the catalog; nothing else is touched.
+# ---------------------------------------------------------------------------
+
+_SECTION_FIELDS = {
+    "paticcas": (PATICCAS_ZH_TW, ("characteristic", "function",
+                                  "manifestation", "proximateCause",
+                                  "doctrinalNote", "examples")),
+    "paccayas": (PACCAYAS_ZH_TW, ("paccayaDhamma", "paccayuppanna",
+                                  "subdivisions", "examples",
+                                  "doctrinalNote")),
+    "kammas": (KAMMAS_ZH_TW, ("doctrinalNote", "examples")),
+    "cetasikas": (CETASIKAS_ZH_TW, ("characteristic", "function",
+                                    "manifestation", "proximateCause")),
+    "rupas": (RUPAS_ZH_TW, ("characteristic", "function",
+                            "manifestation", "proximateCause",
+                            "doctrinalNote")),
+}
+
+
+def apply(catalog):
+    """Fill missing zh_TW fields in ``catalog`` (mutated in place).
+
+    Returns a per-section count of the fields written.
+    """
+    written = {}
+    for section, (source, fields) in _SECTION_FIELDS.items():
+        target = catalog.setdefault(section, {})
+        count = 0
+        for entity_id, data in source.items():
+            node = target.setdefault(entity_id, {})
+            for field in fields:
+                if field in data and not node.get(field):
+                    node[field] = data[field]
+                    count += 1
+        written[section] = count
+
+    vithis = catalog.setdefault("vithis", {})
+    count = 0
+    for vithi_id, data in VITHIS_ZH_TW.items():
+        node = vithis.setdefault(vithi_id, {})
+        for field in ("arisingCondition", "significance", "doctrinalNote"):
+            if field in data and not node.get(field):
+                node[field] = data[field]
+                count += 1
+        steps = node.setdefault("steps", {})
+        for step_number, step in data.get("STEPS", {}).items():
+            step_node = steps.setdefault(step_number, {})
+            for field, value in step.items():
+                if not step_node.get(field):
+                    step_node[field] = value
+                    count += 1
+    written["vithis"] = count
+
+    # Kamma name corrections are deliberate replacements, not fills: they fix
+    # labels attached to the wrong id. Applied only when KAMMA_NAME_CORRECTIONS
+    # is switched on by the integrator after the id/Pāḷi mismatch is confirmed.
+    return written
+
+
+def apply_kamma_name_corrections(catalog):
+    """Replace the mis-keyed kamma name/shortName with the correct ones."""
+    kammas = catalog.setdefault("kammas", {})
+    for kamma_id, (name, short_name, _why) in KAMMA_NAME_CORRECTIONS_ZH_TW.items():
+        node = kammas.setdefault(kamma_id, {})
+        node["name"] = name
+        node["shortName"] = short_name
+    return len(KAMMA_NAME_CORRECTIONS_ZH_TW)
